// use prisma-8

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}
model User {
  id                Uuid   @id @default(uuid())
  email             String @unique
  passwordHash      String @map("password_hash")
  firstName         String @map("first_name")
  lastName          String @map("last_name")
  address           String
  phone             String
  role              String @default("administrator")
  status            UserStatus @default(ACTIVE)
  organization      String?
  billingEmail      String? @map("billing_email")
  billingAddress    String? @map("billing_address")
  passwordUpdatedAt DateTime @map("password_updated_at")

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  properties      Property[]
  propertyCharges PropertyCharge[]
  propertyUnits   PropertyUnit[]
  tenants         Tenant[]
  tenancies       Tenancy[]
  invoices        Invoice[]
  payments        Payment[]
  receipts        Receipt[]

  invoiceBalanceTransfers InvoiceBalanceTransfer[]
  paymentAllocations      PaymentAllocation[]
  oauthAccounts           OAuthAccount[]

  @@map("users")
}

model OAuthAccount {
  id                Uuid     @id @default(uuid())
  userId            Uuid     @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         temporal.createdAt() @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Country {
  id        Uuid   @id @default(uuid())
  name      String @unique

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  cities     City[]
  properties Property[]

  @@map("countries")
}

model City {
  id        Uuid   @id @default(uuid())
  name      String
  countryId Uuid   @map("country_id")

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  country Country @relation(fields: [countryId], references: [id])

  @@index([countryId])
  @@map("cities")
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}
model Property {
  id           Uuid    @id @default(uuid())
  managerId    Uuid    @map("manager_id")
  name         String
  addressLine1 String  @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String
  state        String?
  postalCode   String? @map("postal_code")
  countryId    Uuid    @map("country_id")
  description  String?
  currency     String  @default("KES")
  monthlyRent  Decimal @map("monthly_rent")
  unitCount    Int     @default(0) @map("unit_count")
  status       PropertyStatus  @default(ACTIVE)

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  manager  User     @relation(fields: [managerId], references: [id])
  country Country  @relation(fields: [countryId], references: [id])

  propertyCharges PropertyCharge[]
  propertyUnits   PropertyUnit[]
  tenancies       Tenancy[]
  invoices        Invoice[]
  payments        Payment[]

  @@index([managerId])
  @@index([countryId])
  @@map("properties")
}

model PropertyCharge {
  id               Uuid    @id @default(uuid())
  managerId        Uuid    @map("manager_id")
  propertyId       Uuid    @map("property_id")
  name             String  @unique
  description      String?
  amount           Decimal
  isActive         Boolean @map("is_active")

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  manager  User     @relation(fields: [managerId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  invoiceItems InvoiceItem[]
  unitCharges  PropertyUnitCharge[]

  @@index([managerId])
  @@index([propertyId])
  @@map("property_charges")
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  BI_ANNUALLY
  ANNUALLY
}
enum PropertyUnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  ARCHIVED
}
model PropertyUnit {
  id               Uuid               @id @default(uuid())
  managerId        Uuid               @map("manager_id")
  propertyId       Uuid               @map("property_id")
  unitNumber       String             @map("unit_number")
  bedroomCount     Int                @map("bedroom_count")
  status           PropertyUnitStatus @default(AVAILABLE)
  marketRent       Decimal            @map("market_rent")
  billingFrequency BillingFrequency   @default(MONTHLY) @map("billing_frequency")

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  manager  User     @relation(fields: [managerId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  tenancies   Tenancy[]
  unitCharges PropertyUnitCharge[]

  @@index([managerId])
  @@index([propertyId])
  @@index([propertyId, status])
  @@map("property_units")
}

model PropertyUnitCharge {
  propertyUnitId   Uuid     @map("property_unit_id")
  propertyChargeId Uuid     @map("property_charge_id")
  customAmount     Decimal? @map("custom_amount")
  validFrom        DateTime @map("valid_from")
  validTo          DateTime? @map("valid_to")

  propertyUnit   PropertyUnit   @relation(fields: [propertyUnitId], references: [id])
  propertyCharge PropertyCharge @relation(fields: [propertyChargeId], references: [id])

  @@id([propertyUnitId, propertyChargeId, validFrom])
  @@index([propertyUnitId, validFrom], map: "unit_charge_valid_from_idx")
  @@index([propertyChargeId, validFrom], map: "charge_valid_from_idx")
  @@map("property_unit_charges")
}

enum TenantStatus {
  ACTIVE
  ENDED
}
model Tenant {
  id                    Uuid    @id @default(uuid())
  managerId             Uuid    @map("manager_id")
  firstName             String  @map("first_name")
  lastName              String  @map("last_name")
  email                 String
  phone                 String
  address               String?
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  status                TenantStatus  @default(ACTIVE)

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  manager User @relation(fields: [managerId], references: [id])

  tenancies Tenancy[]
  invoices  Invoice[]
  payments  Payment[]

  @@index([managerId])
  @@map("tenants")
}

enum TenancyStatus {
  ACTIVE
  ENDED
}
model Tenancy {
  id            Uuid             @id @default(uuid())
  managerId     Uuid             @map("manager_id")
  propertyId    Uuid             @map("property_id")
  propertyUnit  String           @map("property_unit")
  propertyUnitId Uuid?           @map("property_unit_id")
  tenantId      Uuid             @map("tenant_id")
  startDate     Date             @map("start_date")
  endDate       Date?            @map("end_date")
  monthlyRent   Decimal          @map("monthly_rent")
  status        TenancyStatus    @default(ACTIVE)
  assignedAt    DateTime         @map("assigned_at")
  unassignedAt  DateTime?        @map("unassigned_at")

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  manager       User          @relation(fields: [managerId], references: [id])
  property      Property      @relation(fields: [propertyId], references: [id])
  unit          PropertyUnit? @relation(fields: [propertyUnitId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  invoices Invoice[]

  @@index([managerId])
  @@index([propertyId, status])
  @@index([tenantId, status])
  @@index([propertyUnitId])
  @@map("tenancies")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}
model Invoice {
  id            Uuid    @id @default(uuid())
  managerId     Uuid    @map("manager_id")
  propertyId    Uuid    @map("property_id")
  tenancyId     Uuid    @map("tenancy_id")
  tenantId      Uuid    @map("tenant_id")
  invoiceNumber String  @unique @map("invoice_number")
  issueDate     Date    @map("issue_date")
  dueDate       Date    @map("due_date")
  subtotal      Decimal
  totalAmount   Decimal @map("total_amount")
  amountPaid    Decimal @map("amount_paid")
  balanceDue    Decimal @map("balance_due")
  status        InvoiceStatus
  notes         String?

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  manager  User     @relation(fields: [managerId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  tenancy  Tenancy  @relation(fields: [tenancyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  invoiceItems InvoiceItem[]
  payments     Payment[]

  outgoingBalanceTransfers InvoiceBalanceTransfer[] @relation("SourceInvoice")
  incomingBalanceTransfers InvoiceBalanceTransfer[] @relation("TargetInvoice")

  paymentAllocations PaymentAllocation[]

  @@index([managerId])
  @@index([propertyId])
  @@index([tenancyId])
  @@index([tenantId])
  @@index([managerId, tenantId, tenancyId, status])
  @@map("invoices")
}

model InvoiceItem {
  id               Uuid    @id @default(uuid())
  invoiceId        Uuid    @map("invoice_id")
  propertyChargeId Uuid?   @map("property_charge_id") // null for plain rent lines
  description      String
  quantity         Decimal
  unitAmount       Decimal @map("unit_amount")
  totalAmount      Decimal @map("total_amount")

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  propertyCharge PropertyCharge? @relation(fields: [propertyChargeId], references: [id])

  @@index([invoiceId])
  @@index([propertyChargeId])
  @@map("invoice_items")
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  REVERSED
  FAILED
}
model Payment {
  id              Uuid    @id @default(uuid())
  managerId       Uuid    @map("manager_id")
  propertyId      Uuid    @map("property_id")
  invoiceId       Uuid    @map("invoice_id")
  tenantId        Uuid    @map("tenant_id")
  paymentDate     Date    @map("payment_date")
  amount          Decimal
  paymentMethod   String  @map("payment_method")
  referenceNumber String? @map("reference_number")
  notes           String?
  status          PaymentStatus

  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  manager  User     @relation(fields: [managerId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  receipt Receipt?

  allocations PaymentAllocation[]

  @@index([managerId])
  @@index([propertyId])
  @@index([invoiceId])
  @@index([tenantId])
  @@index([managerId, tenantId, paymentDate])
  @@map("payments")
}

model Receipt {
  id            Uuid     @id @default(uuid())
  managerId     Uuid     @map("manager_id")
  paymentId     Uuid     @unique @map("payment_id")
  receiptNumber String   @unique @map("receipt_number")
  issuedAt      DateTime @map("issued_at")
  notes         String?

  createdAt temporal.createdAt() @map("created_at")

  manager User    @relation(fields: [managerId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([managerId])
  @@map("receipts")
}

model InvoiceBalanceTransfer {
  id              Uuid     @id @default(uuid())
  managerId       Uuid     @map("manager_id")
  sourceInvoiceId Uuid     @map("source_invoice_id")
  targetInvoiceId Uuid     @map("target_invoice_id")
  amount          Decimal
  transferredAt   DateTime @map("transferred_at")
  notes           String?

  createdAt temporal.createdAt() @map("created_at")

  manager       User    @relation(fields: [managerId], references: [id])
  sourceInvoice Invoice @relation("SourceInvoice", fields: [sourceInvoiceId], references: [id])
  targetInvoice Invoice @relation("TargetInvoice", fields: [targetInvoiceId], references: [id])

  @@index([managerId])
  @@index([sourceInvoiceId])
  @@index([targetInvoiceId])
  @@index([managerId, sourceInvoiceId], map: "inv_bal_tx_mgr_src_idx")
  @@map("invoice_balance_transfers")
}

model PaymentAllocation {
  id          Uuid     @id @default(uuid())
  managerId   Uuid     @map("manager_id")
  paymentId   Uuid     @map("payment_id")
  invoiceId   Uuid     @map("invoice_id")
  amount      Decimal
  allocatedAt DateTime @map("allocated_at")
  notes       String?

  createdAt temporal.createdAt() @map("created_at")

  manager User    @relation(fields: [managerId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([managerId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([managerId, invoiceId])
  @@map("payment_allocations")
}

model IdempotencyKey {
  id        Uuid   @id @default(uuid())
  key       String @unique
  managerId Uuid   @map("manager_id")
  endpoint  String
  response  Json
  createdAt temporal.createdAt() @map("created_at")

  @@index([managerId])
  @@index([key])
  @@map("idempotency_keys")
}
